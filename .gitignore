# ignore files
.vscode/*
.opstool.*
.venv
__pycache__/*
**/__pycache__/
*.py[cod]
*output/
**/*output*/
*.sqlite-shm
*.sqlite-wal

# Publish source, methods and conclusions; keep generated research data local.
/artifacts/
/article/
/literature/transmission_tower_wind/papers/*.pdf
/initial_imperfection_material/**/*.sqlite
/initial_imperfection_material/**/*.csv
/initial_imperfection_material/**/*.json
/initial_imperfection_material/**/*.jsonl
/initial_imperfection_material/**/*.npz
/initial_imperfection_material/**/*.gz
/initial_imperfection_material/**/*.png
/initial_imperfection_material/**/*.svg
/initial_imperfection_material/**/*.pdf
/initial_imperfection_material/**/*.log
/initial_imperfection_material/**/*.txt
/initial_imperfection_material/**/index.html
!/initial_imperfection_material/protocols/**/*.json
!/initial_imperfection_material/tian_ma_qu/followup_results/insulator_audit_20261024/summary.json
/py_view/results_dashboard/validation/
/validation/**/*.png
/validation/**/*.gz
/validation/git_publish_20261024/archive*
/validation/git_publish_20261024/verify_archives.py

# Subsequent milestone pushes: retain source, methods, citations and summaries.
# Full texts, cached publisher pages and binary archives stay in this workspace.
/literature/**/*.pdf
/literature/**/*.txt
/literature/**/*.html
/literature/**/extracted/
/docs/ai_execution_plan/**/*.tar.gz
/docs/ai_execution_plan/**/*.log

# Per-run source copies and browser dumps are generated evidence, not source modules.
/initial_imperfection_material/**/code_snapshot/
/initial_imperfection_material/**/native_source_snapshot/
/initial_imperfection_material/**/dashboard_browser*/

# Rain-load histories, nodal tables, figures and solver output remain local.
/rain_loading/results/*
!/rain_loading/results/REPORT.md
!/rain_loading/results/loading_interface.md
!/rain_loading/results/summary.json
!/rain_loading/results/verification.json
!/rain_loading/results/loading_interface_verification.json
/rain_loading/interface_validation/*
!/rain_loading/interface_validation/summary.json

# Keep web source (HTML/CSS/JS); do not add generated static media.
/static/**/*.png
/static/**/*.jpg
/static/**/*.jpeg
/static/**/*.gif
/static/**/*.webp
/static/**/*.mp4
/static/**/*.pdf
